# Virtual environment
venv/
env/
.venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Model files (large binaries)
*.h5
*.pkl
*.pth
*.onnx
saved_models/

# Raw / adapted datasets (large; not committed — see data/README.md for
# provenance and reproduction commands). data/train_data.csv (tiny synthetic
# sample) is intentionally NOT ignored.
data/raw_cicids/
data/*.parquet
data/cicids_clean.csv
data/*_clean.csv
!data/train_data.csv

# Model artifacts (large binaries; keep on disk, do not commit)
*.keras

# Vendored frontend libs (load from CDN instead)
recharts.js

# Run logs (transient; not reproducible artifacts)
outputs/*.log
logs/
tmp/
.pytest_cache/

# Bulky per-run outputs (regenerated by new.py; metrics + summary plots stay committed)
outputs/entity_timelines_*/
outputs/alert_packets/
# Raw benchmark datasets and immutable local runs (publish only reviewed summaries).
data/cicids*.csv
data/unsw*.csv
outputs/runs/
